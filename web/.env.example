# Copia questo file in .env.local e compila i valori.

# URL pubblico del sito — usato per canonical, Open Graph e sitemap.
# In produzione: https://tuodominio.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# URL del backend Express (estrazione stream / player).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Chiave API TMDB (lato server). Se vuota usa la chiave demo.
TMDB_API_KEY=
